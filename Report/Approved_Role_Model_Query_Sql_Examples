Query: All Role Deletion & Deactivation Events

SELECT 
    timestamp,
    event_id,
    entity_type,
    entity_id,
    entity_name,
    version_number,
    action_type,
    old_value,
    new_value,
    changed_by,
    change_reason
FROM ApprovedRoleModel_AuditLog
WHERE action_type IN ('DEACTIVATE_ROLE', 'DELETE_ROLE', 'REACTIVATE_ROLE')
ORDER BY timestamp DESC;


Query: Currently Inactive / Retired Roles

SELECT 
    id, 
    name, 
    status, 
    version_number, 
    owner_name, 
    activated_timestamp, 
    deactivated_timestamp, 
    deleted_timestamp
FROM ApprovedRoleModel_Roles
WHERE status IN ('DEACTIVATED', 'DELETED')
ORDER BY last_modified_timestamp DESC;


