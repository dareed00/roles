8. Business Role to IT overlap: High-Performance SQL Query (Instant Database Lookup)
SELECT 
    r.id AS business_role_id,
    r.name AS business_role_name,
    ap.id AS it_role_id,
    ap.name AS it_role_name,
    ap.primary_source AS it_role_source,
    -- Overlap Metrics
    COUNT(DISTINCT re.entitlement_id) AS shared_entitlements_count,
    (SELECT COUNT(*) FROM ApprovedRoleModel_AccessProfileEntitlements ape_sub WHERE ape_sub.access_profile_id = ap.id) AS it_role_total_entitlements,
    ROUND(
        (COUNT(DISTINCT re.entitlement_id) / 
        (SELECT COUNT(*) FROM ApprovedRoleModel_AccessProfileEntitlements ape_sub WHERE ape_sub.access_profile_id = ap.id)) * 100, 1
    ) AS containment_percentage,
    -- Governance Action Classification
    CASE 
        WHEN COUNT(DISTINCT re.entitlement_id) = (SELECT COUNT(*) FROM ApprovedRoleModel_AccessProfileEntitlements ape_sub WHERE ape_sub.access_profile_id = ap.id)
            THEN '🟢 100% FULLY CONTAINED (Replace loose entitlements with IT Role)'
        WHEN (COUNT(DISTINCT re.entitlement_id) / (SELECT COUNT(*) FROM ApprovedRoleModel_AccessProfileEntitlements ape_sub WHERE ape_sub.access_profile_id = ap.id)) >= 0.75
            THEN '🟡 PARTIAL OVERLAP (Evaluate adding missing permissions to Business Role)'
        ELSE '⚪ LOW OVERLAP'
    END AS architectural_recommendation
FROM ApprovedRoleModel_Roles r
JOIN ApprovedRoleModel_RoleEntitlements re ON r.id = re.role_id
JOIN ApprovedRoleModel_AccessProfileEntitlements ape ON re.entitlement_id = ape.entitlement_id
JOIN ApprovedRoleModel_AccessProfiles ap ON ape.access_profile_id = ap.id
GROUP BY 
    r.id, r.name, 
    ap.id, ap.name, ap.primary_source
HAVING containment_percentage >= 75.0
ORDER BY containment_percentage DESC, shared_entitlements_count DESC;



