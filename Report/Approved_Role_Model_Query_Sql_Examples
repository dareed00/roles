1. View Complete Version History for a Specific Role

SELECT 
    timestamp,
    version_number,
    action_type,
    field_name,
    old_value,
    new_value,
    changed_by,
    change_reason
FROM ApprovedRoleModel_AuditLog
WHERE entity_id = 'BR-0001'
ORDER BY timestamp DESC, id DESC;

2. View All Roles Modified or Activated in the Last 30 Days

SELECT 
    id,
    name,
    status,
    version_number,
    owner_name,
    activated_timestamp,
    last_modified_timestamp
FROM ApprovedRoleModel_Roles
WHERE last_modified_timestamp >= NOW() - INTERVAL 30 DAY;

3. View All Entitlement Changes Made Across the Entire Program

SELECT 
    event_id,
    entity_name,
    action_type,
    new_value AS details,
    changed_by,
    timestamp
FROM ApprovedRoleModel_AuditLog
WHERE action_type IN ('ADD_ENTITLEMENT', 'REMOVE_ENTITLEMENT')
ORDER BY timestamp DESC;

4. Find All Roles Whose Assignment Rules Were Modified in the Last 30 Days

SELECT 
    id,
    name,
    version_number,
    assignment_rule,
    rule_created_timestamp,
    rule_last_modified_timestamp
FROM ApprovedRoleModel_Roles
WHERE rule_last_modified_timestamp >= NOW() - INTERVAL 30 DAY;

5. Trace Every Change Made to a Role's Assignment Rule Over Time

SELECT 
    timestamp,
    version_number,
    action_type,
    old_value AS previous_rule_logic,
    new_value AS updated_rule_logic,
    change_reason,
    changed_by
FROM ApprovedRoleModel_AuditLog
WHERE entity_id = 'BR-0001' 
  AND action_type IN ('CREATE_RULE', 'MODIFY_RULE')
ORDER BY timestamp DESC, version_number DESC;

6. Trace Ownership Reassignment History across the Enterprise

SELECT 
    timestamp,
    entity_type,
    entity_id,
    entity_name,
    version_number,
    action_type,
    old_value AS previous_owner,
    new_value AS current_owner,
    changed_by
FROM ApprovedRoleModel_AuditLog
WHERE action_type IN ('ASSIGN_OWNER', 'MODIFY_OWNER')
